# Copy this to .env and fill in values for your machine.
# Never commit .env — it's git-ignored.

# Real cloud server (Memoona's codehands-backend).
# Start it: cd ../codehands-backend && npm run dev
VITE_CLOUD_URL=http://localhost:3000

# OR use the mock server instead of the real backend:
# VITE_CLOUD_URL=http://localhost:4000

# GitHub OAuth client ID (get from your GitHub OAuth App settings)
# Only needed for real GitHub login — mock accepts any code.
# VITE_GITHUB_CLIENT_ID=your_client_id_here

